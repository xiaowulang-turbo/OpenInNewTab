{
    "compilerOptions": {
        "noEmit": true,
        "allowJs": true,
        "checkJs": false,
        "skipLibCheck": true,
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler"
    },
    "include": [
        "extension/**/*.js",
        "userscript/**/*.js",
        "website/**/*.js",
        "scripts/**/*.mjs"
    ],
    "exclude": ["node_modules", "release"]
}
